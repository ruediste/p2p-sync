{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Simple FUSE Filesystem",
      "request": "launch",
      "mainClass": "com.github.ruediste.p2psync.storage.SimpleFuseMain",
      "preLaunchTask": "Build p2p-sync for launch",
      "classPaths": [
        "${workspaceFolder}/p2p-sync/target/classes",
        "${workspaceFolder}/p2p-sync/target/dependency/*"
      ],
      "modulePaths": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      // "args": ["${input:fuseBackingFile}", "${input:fuseMountDirectory}"]
      "args": ["files.db", "mount"]
    },
    {
      "type": "java",
      "name": "FSCK",
      "request": "launch",
      "mainClass": "com.github.ruediste.p2psync.storage.StorageCheckMain",
      "preLaunchTask": "Build p2p-sync for launch",
      "classPaths": [
        "${workspaceFolder}/p2p-sync/target/classes",
        "${workspaceFolder}/p2p-sync/target/dependency/*"
      ],
      "modulePaths": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      // "args": ["${input:fuseBackingFile}", "${input:fuseMountDirectory}"]
      "args": ["node.db"]
    },
    {
      "type": "java",
      "name": "p2p-sync Node Desktop",
      "request": "launch",
      "mainClass": "com.github.ruediste.p2psync.ui.DesktopMain",
      "preLaunchTask": "Build p2p-sync for launch",
      "classPaths": [
        "${workspaceFolder}/p2p-sync/target/classes",
        "${workspaceFolder}/p2p-sync/target/dependency/*"
      ],
      "modulePaths": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      // "args": ["${input:nodeDataDirectory}", "${input:nodeMountDirectory}"]
      "args": ["--drive", "9222", "node.db", "mount"]
    },
    {
      "type": "java",
      "name": "p2p-sync Node Desktop2",
      "request": "launch",
      "mainClass": "com.github.ruediste.p2psync.ui.DesktopMain",
      "preLaunchTask": "Build p2p-sync for launch",
      "classPaths": [
        "${workspaceFolder}/p2p-sync/target/classes",
        "${workspaceFolder}/p2p-sync/target/dependency/*"
      ],
      "modulePaths": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      // "args": ["${input:nodeDataDirectory}", "${input:nodeMountDirectory}"]
      "args": ["node2.db", "mount2"]
    },
    {
      "type": "java",
      "name": "JReact Storybook",
      "request": "launch",
      "mainClass": "com.github.ruediste.jreact.storybook.Storybook",
      "projectName": "jreact-storybook",
      "vmArgs": "-XX:+EnableDynamicAgentLoading"
    }
  ],
  "inputs": [
    {
      "id": "fuseBackingFile",
      "type": "promptString",
      "description": "DataStorage backing file (outside the mount directory)",
      "default": "files.db"
    },
    {
      "id": "fuseMountDirectory",
      "type": "promptString",
      "description": "Existing empty FUSE mount directory",
      "default": "mount"
    },
    {
      "id": "nodeDataDirectory",
      "type": "promptString",
      "description": "Persistent node data directory",
      "default": "node-data"
    },
    {
      "id": "nodeMountDirectory",
      "type": "promptString",
      "description": "Existing or new user filesystem mount directory",
      "default": "node-mount"
    }
  ]
}
